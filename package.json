{
  "name": "mv-ai-bridge",
  "version": "0.1.0",
  "description": "Let AI agents play RPG Maker MV games through native MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mv-ai-bridge": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js serve",
    "dev": "tsc -p tsconfig.json && node dist/cli/index.js serve",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "rpg-maker-mv",
    "mcp",
    "agent",
    "game-automation"
  ],
  "dependencies": {
