    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K-ame/rpgmaker-mv-ai-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/K-ame/rpgmaker-mv-ai-bridge/issues"
  },
  "homepage": "https://github.com/K-ame/rpgmaker-mv-ai-bridge#readme"
